{
  "name": "cli-team",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "description": "CLI Team 中文桌面协作工作台",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "start": "node tools/launch.mjs",
    "build": "vite build",
    "package:desktop": "node tools/package-desktop.mjs",
    "dist:desktop": "npm run build && npm run package:desktop",
    "smoke:desktop": "node tools/smoke-desktop.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "tsc --noEmit",
    "team": "node tools/team.mjs",
    "mcp": "node tools/mcp.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@electron/asar": "4.3.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "express": "^5.1.0",
    "fzstd": "^0.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.7.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.0"
  }
}
